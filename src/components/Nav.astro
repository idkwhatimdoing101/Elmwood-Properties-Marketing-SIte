---
import elmwoodLogo from "../assets/images/elmwood-logo.png";
import { calendlyUrl } from "../data/site";

const links: NavItem[] = [
  { href: "/", label: "Home" },
  { href: "/floor-plans", label: "Floor Plans" },
  { href: "/amenities", label: "Amenities" },
  { href: "/neighborhood", label: "Neighborhood" },
  { href: "/gallery", label: "Gallery" },
  {
    label: "Residents",
    children: [
      { href: "/maintenance-request", label: "Maintenance Request" },
      { label: "Make a Payment (coming soon)" },
    ],
  },
  { href: "/contact", label: "Contact" },
  { href: "/apply", label: "Apply" },
];

type NavItem = { href?: string; label: string; children?: NavItem[] };

const current = Astro.url.pathname;
---

<div class="site-header">
  <div class="utility-bar">
    <div class="wrap utility-bar__row">
      <div class="utility-bar__info">
        <a href="tel:+16126234488" class="utility-bar__phone">(612) 623-4488 — we answer, day or night</a>
        <span class="utility-bar__address">1420 Rollins Ave SE, Minneapolis, MN</span>
      </div>
      <a href="/apply" class="utility-bar__apply" aria-current={current === "/apply" ? "page" : undefined}>Ready to Apply? Click Here! →</a>
    </div>
  </div>

  <header class="nav">
    <div class="wrap nav__row">
      <a href="/" class="nav__brand">
        <img src={elmwoodLogo.src} width={elmwoodLogo.width} height={elmwoodLogo.height} alt="Elmwood" class="nav__brand-img" />
      </a>

      <button
        class="nav__toggle"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label="Open menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

      <nav class="nav__menu" id="nav-menu">
        <ul class="nav__links">
          {
            links.map((link) =>
              link.children ? (
                <li class="nav__dropdown">
                  <button
                    type="button"
                    class="nav__link nav__dropdown-toggle"
                    aria-expanded="false"
                    aria-current={link.children.some((c) => c.href === current) ? "page" : undefined}
                  >
                    {link.label}
                    <svg class="nav__caret" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
                      <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  </button>
                  <ul class="nav__submenu">
                    {link.children.map((child) => (
                      <li>
                        {child.href ? (
                          <a
                            href={child.href}
                            class="nav__sublink"
                            aria-current={current === child.href ? "page" : undefined}
                          >
                            {child.label}
                          </a>
                        ) : (
                          <span class="nav__sublink nav__sublink--disabled" aria-disabled="true">
                            {child.label}
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li>
                  <a
                    href={link.href}
                    class="nav__link"
                    aria-current={current === link.href ? "page" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              )
            )
          }
        </ul>
        <a href={calendlyUrl} target="_blank" rel="noopener" class="btn btn-primary nav__cta">Book a Tour</a>
      </nav>
    </div>
  </header>
</div>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
    toggle.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
  });

  // Residents dropdown: hover opens it on desktop (CSS); click/tap and keyboard toggle it.
  const dropdowns = document.querySelectorAll<HTMLElement>(".nav__dropdown");
  const closeAll = (except?: HTMLElement) =>
    dropdowns.forEach((d) => {
      if (d !== except) d.querySelector(".nav__dropdown-toggle")?.setAttribute("aria-expanded", "false");
    });

  dropdowns.forEach((dropdown) => {
    const btn = dropdown.querySelector(".nav__dropdown-toggle");
    btn?.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") === "true";
      closeAll(dropdown);
      btn.setAttribute("aria-expanded", String(!open));
    });
  });

  document.addEventListener("click", (e) => {
    if (!(e.target as Element).closest(".nav__dropdown")) closeAll();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeAll();
  });

  menu?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => {
      menu.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .utility-bar {
    background: var(--color-charcoal);
    color: var(--color-text-on-dark);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .utility-bar__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 0.55rem;
    flex-wrap: wrap;
  }

  .utility-bar__info {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .utility-bar__address {
    position: relative;
    padding-left: 1rem;
  }

  .utility-bar__address::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.5;
  }

  .utility-bar__phone,
  .utility-bar__apply {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s ease;
  }

  .utility-bar__phone:hover,
  .utility-bar__apply:hover {
    color: var(--color-brass-light);
  }

  .utility-bar__apply {
    color: var(--color-brass-light);
  }

  .nav {
    background: var(--color-ivory);
    border-bottom: 1px solid var(--color-sage-line);
  }

  .nav__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.1rem;
  }

  .nav__brand {
    display: flex;
    align-items: center;
  }

  .nav__brand-img {
    height: 2.1rem;
    width: auto;
  }

  @media (max-width: 56rem) {
    .nav__brand-img {
      height: 1.75rem;
    }
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.25rem;
    height: 2.25rem;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .nav__toggle span {
    display: block;
    height: 2px;
    background: var(--color-charcoal);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav__menu {
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 1.85rem;
  }

  .nav__link {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--color-text);
    position: relative;
    padding-block: 0.25rem;
  }

  .nav__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1px;
    background: var(--color-forest);
    transition: right 0.25s ease;
  }

  .nav__link:hover::after,
  .nav__link[aria-current="page"]::after {
    right: 0;
  }

  .nav__link[aria-current="page"] {
    color: var(--color-forest);
  }

  /* Residents dropdown */
  .nav__dropdown {
    position: relative;
  }

  .nav__dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: none;
    font-family: inherit;
    cursor: pointer;
  }

  .nav__caret {
    transition: transform 0.2s ease;
  }

  .nav__dropdown-toggle[aria-expanded="true"] .nav__caret {
    transform: rotate(180deg);
  }

  .nav__submenu {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: -1rem;
    min-width: 15rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.5rem;
    background: var(--color-ivory);
    border: 1px solid var(--color-sage-line);
    border-radius: var(--radius-md);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.1);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
  }

  /* Invisible bridge so the menu doesn't close while the mouse crosses the gap. */
  .nav__submenu::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -0.85rem;
    height: 0.85rem;
  }

  .nav__dropdown:hover .nav__submenu,
  .nav__dropdown:focus-within .nav__submenu,
  .nav__dropdown-toggle[aria-expanded="true"] + .nav__submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav__sublink {
    display: block;
    padding: 0.6rem 0.75rem;
    border-radius: calc(var(--radius-md) - 2px);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  a.nav__sublink:hover,
  .nav__sublink[aria-current="page"] {
    background: var(--color-sage);
    color: var(--color-forest);
  }

  .nav__sublink--disabled {
    color: var(--color-text-muted);
    cursor: default;
  }

  @media (max-width: 56rem) {
    .nav__dropdown-toggle {
      font-size: 1.15rem;
      padding: 0;
    }

    .nav__submenu {
      position: static;
      min-width: 0;
      padding: 0 0 0 1rem;
      margin-top: 0;
      background: none;
      border: none;
      box-shadow: none;
      transform: none;
      display: none;
    }

    .nav__submenu::before {
      display: none;
    }

    .nav__dropdown-toggle[aria-expanded="true"] + .nav__submenu {
      display: flex;
      margin-top: 0.75rem;
    }

    .nav__sublink {
      font-size: 1rem;
      padding: 0.4rem 0;
    }

    a.nav__sublink:hover,
    .nav__sublink[aria-current="page"] {
      background: none;
    }

    .utility-bar__address {
      display: none;
    }

    .nav__toggle {
      display: flex;
    }

    .nav__menu {
      position: fixed;
      inset: 0 0 0 30%;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 2.5rem;
      background: var(--color-ivory);
      padding: 3rem var(--gutter);
      transform: translateX(100%);
      transition: transform 0.3s ease;
      border-left: 1px solid var(--color-sage-line);
    }

    .nav__menu.is-open {
      transform: translateX(0);
    }

    .nav__links {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .nav__link {
      font-size: 1.15rem;
    }
  }
</style>
