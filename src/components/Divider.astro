---
interface Props {
  tone?: "forest" | "brass";
}

const { tone = "forest" } = Astro.props;
---

<div class={`divider divider--${tone}`} role="presentation" aria-hidden="true">
  <span class="divider__line"></span>
  <svg class="divider__sprig" viewBox="0 0 120 28" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M2 14 H118" stroke-width="1" />
    <path d="M46 14 C50 6 58 4 64 6" stroke-width="1" />
    <path d="M54 14 C58 22 66 24 72 22" stroke-width="1" />
    <path d="M64 6 C64 6 62 2 66 1" stroke-width="1" stroke-linecap="round" />
    <path d="M72 22 C72 22 74 26 70 27" stroke-width="1" stroke-linecap="round" />
    <circle cx="60" cy="14" r="2.25" stroke-width="1" />
  </svg>
  <span class="divider__line"></span>
</div>

<style>
  .divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 22rem;
    margin-inline: auto;
  }

  .divider__line {
    flex: 1;
    height: 1px;
    background: var(--color-sage-line);
  }

  .divider__sprig {
    flex-shrink: 0;
    width: 5.5rem;
    height: auto;
    overflow: visible;
  }

  .divider__sprig path,
  .divider__sprig circle {
    stroke: var(--color-forest);
  }

  .divider--brass .divider__sprig path,
  .divider--brass .divider__sprig circle {
    stroke: var(--color-brass-light);
  }

  .divider--brass .divider__line {
    background: rgba(252, 251, 244, 0.18);
  }
</style>
