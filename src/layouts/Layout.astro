---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { cleanPath } from "../utils/pagePath";
import { buildingContent } from "../data/buildings";
import { mapPoints } from "../data/mapPoints";
import { offerings } from "../data/floorplans";

interface Props {
  title: string;
  description: string;
  /** Ask search engines not to list this page (e.g. "coming soon" placeholders). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const ogImage = new URL("/images/elmwood-og.jpg", Astro.site ?? Astro.url);
const pageUrl = new URL(cleanPath(Astro.url.pathname), Astro.site ?? Astro.url);

const prices = offerings.map((o) => o.price).filter((p): p is number => p !== null);
const priceRange = `$${Math.min(...prices).toLocaleString()}-$${Math.max(...prices).toLocaleString()}`;

// Multi-location markup: one ApartmentComplex entry per building, tied to the parent org below.
const locations = buildingContent.map((b) => {
  const point = mapPoints.find((p) => p.href === `/buildings/${b.slug}`);
  return {
    "@type": "ApartmentComplex",
    name: b.name,
    description: b.heroDescription,
    url: new URL(`/buildings/${b.slug}`, Astro.site ?? Astro.url).toString(),
    telephone: "+1-612-623-4488",
    address: {
      "@type": "PostalAddress",
      streetAddress: b.address,
      addressLocality: "Minneapolis",
      addressRegion: "MN",
      postalCode: "55414",
      addressCountry: "US",
    },
    ...(point
      ? { geo: { "@type": "GeoCoordinates", latitude: point.lat, longitude: point.lng } }
      : {}),
  };
});

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "ApartmentComplex",
  name: "Elmwood Apartments",
  description:
    "Studio through four-bedroom apartments near the University of Minnesota, in the SE Como and Marcy-Holmes neighborhoods of Minneapolis, MN.",
  url: (Astro.site ?? Astro.url).toString(),
  telephone: "+1-612-623-4488",
  priceRange,
  address: {
    "@type": "PostalAddress",
    streetAddress: "1420 Rollins Ave SE",
    addressLocality: "Minneapolis",
    addressRegion: "MN",
    postalCode: "55414",
    addressCountry: "US",
  },
  areaServed: ["University of Minnesota", "Dinkytown", "SE Como", "Marcy-Holmes", "Minneapolis, MN"],
  location: locations,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | Elmwood Apartments</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Elmwood Apartments" />
    <meta property="og:title" content={`${title} | Elmwood Apartments`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={pageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}

    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,400..600&family=Montserrat:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '3069551286569052');
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=3069551286569052&ev=PageView&noscript=1"
      />
    </noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Meta Pixel conversion tracking: fires on tour bookings (link click) -->
    <!-- SubmitApplication fires from src/scripts/apply-form.js on a successful application submit -->
    <script is:inline>
      document.addEventListener("click", function (event) {
        var link = event.target.closest("a[href]");
        if (!link || typeof fbq !== "function") return;

        if (link.href.indexOf("calendly.com") !== -1) {
          fbq("track", "Schedule", { content_name: "Book a Tour" });
        }
      });
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -999px;
    top: auto;
    background: var(--color-charcoal);
    color: var(--color-ivory);
    padding: 0.9em 1.4em;
    z-index: 200;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .skip-link:focus {
    left: 1rem;
    top: 1rem;
  }
</style>
