---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Divider from "../components/Divider.astro";
import Photo from "../components/Photo.astro";
import FloorplanCarousel from "../components/FloorplanCarousel.astro";
import elmwoodHero from "../assets/images/elmwood-hero.jpg";
import dinkytownPhoto from "../assets/images/dinkytown.jpg";
import mspTerminalPhoto from "../assets/images/msp-terminal-2.jpg";
import { calendlyUrl } from "../data/site";

const included = ["Parking", "Internet", "Water", "Bicycle Storage"];

const qualityPoints = [
  "Affordable — often half the cost of a dorm room",
  "Clean, secure, and private — your own space, your own key",
  "The most ideal locations for U of M students, staff, and professors",
  "Away from the noise and congestion of dorms and crowded high-rises",
  "24/7 maintenance, because a broken faucet shouldn't wait for Monday",
];

const securityPoints = [
  "Security cameras cover halls, laundry rooms, parking areas, and every front and rear door",
  "Keyless entry and internet-monitored surveillance across the property",
  "A real person answers the phone, day or night",
  "Someone is always reachable — call any hour, any day",
];

const landmarks = [
  "Dinkytown's shops, coffee, and late-night food",
  "Bierman Field Athletic Complex",
  "U.S. Bank Stadium",
  "Mariucci Arena",
  "Van Cleve Park",
];
---

<Layout
  title="Your U of M Home"
  description="Elmwood Apartments — affordable, clean, secure student housing minutes from the University of Minnesota in SE Como and Marcy-Holmes."
>
  <section class="hero">
    <Image
      src={elmwoodHero}
      alt="A grid of Elmwood apartment buildings and sunlit interiors near SE Como, Minneapolis"
      class="hero__media"
      widths={[640, 1000, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 35%; display: block; z-index: 0;"
    />
    <div class="hero__scrim"></div>
    <div class="wrap hero__content">
      <div class="hero__panel">
        <div class="hero__col-header">
          <p class="eyebrow">SE Como · Marcy-Holmes · Blocks from Dinkytown</p>
          <h1>Elmwood Apartments: your U of M home.</h1>
        </div>
        <div class="hero__col-body">
          <p class="lede">
            Elmwood is the best place to live near the University of Minnesota — a few blocks
            from campus, near Dinkytown, in the SE Como and Marcy-Holmes neighborhoods.
          </p>
          <ul class="hero__included">
            {included.map((item) => <li>{item}</li>)}
          </ul>
          <p class="hero__note">
            Included in rent for most apartments. Some residences include in-apartment laundry.
            Our team cleans and sanitizes every building, every day.
          </p>
          <div class="hero__actions">
            <a href={calendlyUrl} target="_blank" rel="noopener" class="btn btn-primary">Book a Tour</a>
            <a href="/floor-plans" class="btn btn-outline">View Floor Plans</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FloorplanCarousel />

  <Divider />

  <section class="section">
    <div class="wrap residences">
      <div class="residences__text">
        <p class="eyebrow">Elmwood Residences</p>
        <h2>Studios to four-bedroom homes, all within walking distance of each other.</h2>
        <p class="lede">
          Studio, 1, 2, 3, and 4 bedroom apartments and houses, all located in the SE Como
          and Marcy-Holmes neighborhoods, near Van Cleve Park.
        </p>
        <a href="/floor-plans" class="text-link">See every floor plan and price →</a>
        <div class="ada-callout" id="accessibility">
          <p class="ada-callout__title">Accessible, ADA-compliant housing</p>
          <p>
            Several Elmwood residences are built for accessibility. Reach out to our office
            to talk through what disability-compliant housing options we have available.
          </p>
          <a href="/contact" class="text-link">Talk to our leasing office →</a>
        </div>
      </div>
      <Photo label="Studio interior, quarry tile floor" ratio="1 / 1" tone="sage" />
    </div>
  </section>

  <section class="section section--sage">
    <div class="wrap quality">
      <div class="quality__text">
        <p class="eyebrow">Elmwood Quality</p>
        <h2>Real quality, at half the cost of the dorms.</h2>
      </div>
      <ul class="quality__list">
        {qualityPoints.map((point) => <li>{point}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap convenience">
      <Image
        src={dinkytownPhoto}
        alt="Dinkytown shops and restaurants near the University of Minnesota"
        widths={[400, 800, 1200]}
        sizes="(max-width: 56rem) 100vw, 45vw"
        loading="lazy"
        class="convenience__img"
      />
      <div class="convenience__text">
        <p class="eyebrow">Elmwood Convenience</p>
        <h2>Walk or bike 15 minutes to campus.</h2>
        <p class="lede">
          Elmwood is close to all your favorite stores, restaurants, parks, and sports
          activities — and the Metro Transit bus departs right from the corner, connecting
          you anywhere around campus.
        </p>
        <ul class="convenience__list">
          {landmarks.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap security">
      <p class="eyebrow">Elmwood Security</p>
      <h2>You should never have to think twice about safety.</h2>
      <ul class="security__list">
        {securityPoints.map((point) => <li>{point}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap international">
      <Image
        src={mspTerminalPhoto}
        alt="MSP Airport, where many international students arrive in Minneapolis"
        widths={[500, 900, 1400]}
        sizes="(max-width: 56rem) 100vw, 50vw"
        loading="lazy"
        class="international__img"
      />
      <div class="international__text">
        <p class="eyebrow">Elmwood International</p>
        <h2>Coming to the U of M from somewhere else? Welcome.</h2>
        <p class="lede">
          Elmwood welcomes international students attending the University of Minnesota.
          Our office is used to helping students settle in from out of state and out of the
          country alike — reach out with any questions before you arrive.
        </p>
        <a href="/contact" class="btn btn-outline">Contact the office</a>
      </div>
    </div>
  </section>

  <section class="section value">
    <div class="wrap value__inner">
      <p class="eyebrow">Elmwood Value</p>
      <h2>Make the most of your U of M years.</h2>
      <p class="lede value__lede">
        Responsive management and well-maintained apartments mean a better quality of life,
        without the dorm price tag. Get the best value and quality housing near campus —
        and make the most of your University of Minnesota investment.
      </p>
      <div class="hero__actions">
        <a href={calendlyUrl} target="_blank" rel="noopener" class="btn btn-primary">Book a Tour</a>
        <a href="/floor-plans" class="btn btn-outline">See Pricing</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(30rem, 68vh, 40rem);
    overflow: hidden;
    color: var(--color-ivory);
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(22, 25, 21, 0.5) 0%,
      rgba(22, 25, 21, 0.16) 24%,
      rgba(22, 25, 21, 0.16) 76%,
      rgba(22, 25, 21, 0.5) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-block: clamp(3rem, 10vw, 6rem) clamp(3rem, 6vw, 4.5rem);
  }

  .hero__panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    max-width: 66rem;
    background: rgba(249, 248, 241, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: var(--radius-md);
    padding: clamp(1.75rem, 4vw, 3rem);
    box-shadow: 0 24px 60px -24px rgba(22, 25, 21, 0.4);
  }

  .hero__panel .eyebrow {
    color: var(--color-forest);
  }

  .hero__panel h1 {
    color: var(--color-charcoal);
    margin-top: 0.9rem;
  }

  .hero__panel .lede {
    color: var(--color-text-muted);
  }

  .hero__included {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .hero__included li {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.45em 0.9em;
    background: var(--color-sage);
    border: 1px solid var(--color-sage-line);
    border-radius: 999px;
    color: var(--color-charcoal);
  }

  .hero__note {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    max-width: 32em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  @media (max-width: 48rem) {
    .hero__panel {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  @media (max-width: 30rem) {
    .hero {
      min-height: clamp(26rem, 72vh, 34rem);
    }
  }

  .residences {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .residences__text .lede {
    margin-block: 1.1rem 1.5rem;
  }

  .text-link {
    display: inline-block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-forest);
    text-decoration: none;
    border-bottom: 1px solid var(--color-forest);
    padding-bottom: 2px;
  }

  .ada-callout {
    margin-top: 2.5rem;
    padding: 1.5rem;
    border: 1px solid var(--color-sage-line);
    border-radius: var(--radius-md);
    background: var(--color-sage);
  }

  .ada-callout__title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .ada-callout p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 0.9rem;
  }

  .quality {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .quality__text h2 {
    margin-top: 0.9rem;
  }

  .quality__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .quality__list li {
    padding-left: 1.6rem;
    position: relative;
    font-size: 1rem;
    line-height: 1.6;
  }

  .quality__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-forest);
  }

  .convenience {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .convenience__img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    display: block;
  }

  .convenience__text h2 {
    margin-block: 0.9rem 1rem;
  }

  .convenience__list {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem 1.5rem;
  }

  .convenience__list li {
    font-size: 0.9375rem;
    padding-left: 1.1rem;
    position: relative;
    color: var(--color-text-muted);
  }

  .convenience__list li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-brass);
  }

  .security h2 {
    margin-block: 0.9rem 2rem;
    max-width: 30em;
  }

  .security__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 3rem;
    max-width: 56rem;
  }

  .security__list li {
    font-size: 1rem;
    line-height: 1.6;
    padding-left: 1.6rem;
    position: relative;
    color: var(--color-text-on-dark-muted);
  }

  .security__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-brass-light);
  }

  .international {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .international__img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-md);
    display: block;
  }

  .international__text h2 {
    margin-block: 0.9rem 1rem;
  }

  .international__text .lede {
    margin-bottom: 1.75rem;
  }

  .value {
    background: var(--color-forest);
    color: var(--color-ivory);
    text-align: center;
  }

  .value h2 {
    color: var(--color-ivory);
  }

  .value .eyebrow {
    color: var(--color-brass-light);
  }

  .value__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .value__lede {
    color: rgba(252, 251, 244, 0.82);
    max-width: 38em;
  }

  .value .hero__actions {
    justify-content: center;
    margin-top: 1rem;
  }

  .value .btn-outline {
    color: var(--color-ivory);
    border-color: rgba(252, 251, 244, 0.5);
  }

  .value .btn-outline:hover {
    background: rgba(252, 251, 244, 0.14);
    color: var(--color-ivory);
  }

  @media (max-width: 56rem) {
    .residences,
    .quality,
    .convenience,
    .international {
      grid-template-columns: 1fr;
    }

    .security__list {
      grid-template-columns: 1fr;
    }
  }
</style>
