---
import Layout from "../layouts/Layout.astro";
import { web3FormsMaintenanceKey } from "../data/site";
---

<Layout
  title="Maintenance Request"
  description="Submit a maintenance request for your Elmwood apartment. Emergencies are answered 24/7 by phone."
>
  <!-- Page heading kept for screen readers and search engines; hidden visually per client request. -->
  <h1 class="visually-hidden">Maintenance Request</h1>

  <section class="section">
    <div class="wrap wrap--narrow">
      <form
        class="web3-form"
        name="maintenance-request"
        data-access-key={web3FormsMaintenanceKey}
        data-subject="Maintenance request ({urgency}) — {address}"
      >
        <!-- Spam honeypot: Web3Forms drops submissions where this is checked. -->
        <input type="checkbox" name="botcheck" hidden tabindex="-1" autocomplete="off" />

        <div class="form-grid">
          <div class="field">
            <label for="name">Full name</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="phone">Phone</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" required />
          </div>
          <div class="field field--full">
            <label for="email">Email (optional)</label>
            <input id="email" name="email" type="email" autocomplete="email" />
          </div>
          <div class="field field--full">
            <label for="address">Building address &amp; unit number</label>
            <input id="address" name="address" type="text" placeholder="e.g. 1420 Rollins Ave SE, Unit 3" required />
          </div>
          <div class="field">
            <label for="urgency">Urgency</label>
            <select id="urgency" name="urgency" required>
              <option value="">Select one</option>
              <option>Urgent</option>
              <option>Routine</option>
            </select>
          </div>
          <div class="field">
            <label for="category">Category</label>
            <select id="category" name="category" required>
              <option value="">Select one</option>
              <option>Plumbing</option>
              <option>Electrical</option>
              <option>Appliance</option>
              <option>Heating / Cooling</option>
              <option>Locks / Security</option>
              <option>Pest</option>
              <option>Other</option>
            </select>
          </div>
          <div class="field field--full">
            <label for="description">What's going on?</label>
            <textarea id="description" name="description" required></textarea>
          </div>
          <div class="field field--full">
            <label for="entry">Permission to enter if you're not home?</label>
            <select id="entry" name="entry" required>
              <option value="">Select one</option>
              <option>Yes, you can enter</option>
              <option>No, please contact me first</option>
            </select>
          </div>
        </div>

        <button type="submit" class="btn btn-primary">Submit Request</button>
      </form>

      <div class="form-status" data-form-status hidden>
        <p data-success>We have received your maintenance request. Thank you.</p>
        <p data-error>Something went wrong submitting that. Please call us directly at (612) 623-4488.</p>
      </div>

      <p class="emergency-note">
        If this is an emergency, please call <a href="tel:+16126234488">(612) 623-4488</a>.
      </p>
    </div>
  </section>
</Layout>

<script>
  import "../scripts/web3-form.js";
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .emergency-note {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-sage-line);
    font-weight: 600;
    color: var(--color-text);
  }

  .emergency-note a {
    color: var(--color-forest);
    white-space: nowrap;
  }

  .form-status {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    font-size: 0.9375rem;
  }

  .form-status[data-state="success"] {
    background: var(--color-sage);
    color: var(--color-forest-deep);
  }

  .form-status[data-state="error"] {
    background: #f6e6e0;
    color: #7a3420;
  }

  .form-status p {
    display: none;
  }
</style>
