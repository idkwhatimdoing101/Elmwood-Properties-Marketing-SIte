---
import Layout from "../layouts/Layout.astro";
import Divider from "../components/Divider.astro";
import Photo from "../components/Photo.astro";
import { buildings, unitTypes, startingPrice, bedLabel, fmt } from "../data/floorplans";
---

<Layout
  title="Floor Plans"
  description="Studio through 5-bedroom apartments and houses at Elmwood, in the SE Como and Marcy-Holmes neighborhoods of Minneapolis, MN — minutes from the University of Minnesota (U of M). See current pricing by building."
>
  <section class="section hero-sm">
    <div class="wrap">
      <p class="eyebrow">Floor Plans</p>
      <h1>Six sizes, one standard of upkeep.</h1>
      <p class="lede">
        From a studio to a five-bedroom house, every Elmwood residence gets the same quarry
        tile floors, the same 24/7 maintenance, and the same team answering the phone.
      </p>
    </div>
  </section>

  <Divider />

  <section class="section">
    <div class="wrap plans-grid">
      {
        unitTypes.map((type) => {
          const price = startingPrice(type.key);
          return (
            <div class="plan-card" id={type.key}>
              <Photo label={`${type.name} layout`} ratio="4 / 3" tone="sage" />
              <div class="plan-card__body">
                <h3>{type.name}</h3>
                <p class="plan-card__meta">{bedLabel(type.beds)}</p>
                <p class="plan-card__price">
                  {price ? `Starting at ${fmt(price)}/mo` : "Contact us for current pricing"}
                </p>
                <a href="/apply" class="btn btn-outline plan-card__cta">
                  Apply for this floor plan
                </a>
              </div>
            </div>
          );
        })
      }
    </div>

    <div class="wrap houses-note">
      <p class="eyebrow">Looking for a house instead?</p>
      <p class="lede">
        Several of our 3, 4, and 5 bedroom floor plans are full houses, not apartment units —
        same SE Como and Marcy-Holmes neighborhoods, same Elmwood upkeep. Let us know what
        you're looking for and we'll tell you what's available.
      </p>
      <a href="/contact" class="text-link">Ask about house availability →</a>
    </div>
  </section>

  <section class="section section--sage">
    <div class="wrap">
      <p class="eyebrow">By Building</p>
      <h2 class="table-heading">Current pricing, address by address.</h2>
      <p class="lede table-lede">
        All seven Elmwood buildings sit in the SE Como and Marcy-Holmes neighborhoods of
        Minneapolis, MN, within about a mile of the University of Minnesota campus. Pricing
        shown as of July 2026 and subject to change — call or apply to confirm what's actually
        available right now.
      </p>

      <ul class="building-list">
        {
          buildings.map((b) => {
            const available = unitTypes.filter((type) => b[type.key] !== null);
            return (
              <li class="building-card">
                <h3 class="building-card__address">{b.address}, Minneapolis, MN</h3>
                <ul class="building-card__prices">
                  {
                    available.map((type) => (
                      <li>
                        <span class="building-card__type">{type.name}</span>
                        <span class="building-card__price">{fmt(b[type.key])}/mo</span>
                      </li>
                    ))
                  }
                </ul>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="section cta">
    <div class="wrap cta__inner">
      <h2>Included in rent for most apartments</h2>
      <p class="lede cta__lede">Parking, internet, water, and bicycle storage — see the full list on Amenities.</p>
      <div class="cta__actions">
        <a href="/amenities" class="btn btn-primary">View Amenities</a>
        <a href="/apply" class="btn btn-outline">Apply Now</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-sm h1 {
    margin-block: 0.9rem 1rem;
    max-width: 34rem;
  }

  .hero-sm .lede {
    max-width: 36rem;
  }

  .plans-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem;
    margin-bottom: 3.5rem;
  }

  .plan-card {
    border: 1px solid var(--color-sage-line);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-ivory);
    scroll-margin-top: 7rem;
  }

  .plan-card__body {
    padding: 1.5rem;
  }

  .plan-card__meta {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-block: 0.4rem 0.9rem;
  }

  .plan-card__price {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-forest);
    margin-bottom: 1.25rem;
  }

  .plan-card__cta {
    width: 100%;
    justify-content: center;
  }

  .houses-note {
    max-width: 38rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-sage-line);
  }

  .houses-note .lede {
    margin-block: 0.9rem 1.25rem;
  }

  .text-link {
    display: inline-block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-forest);
    text-decoration: none;
    border-bottom: 1px solid var(--color-forest);
    padding-bottom: 2px;
  }

  .table-heading {
    margin-block: 0.9rem 0.6rem;
  }

  .table-lede {
    margin-bottom: 2rem;
    max-width: 42em;
  }

  .building-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .building-card {
    padding: 1.5rem;
    background: var(--color-ivory);
    border: 1px solid var(--color-sage-line);
    border-radius: var(--radius-md);
  }

  .building-card__address {
    font-size: 1rem;
    margin-bottom: 1rem;
  }

  .building-card__prices {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .building-card__prices li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--color-sage-line);
    font-size: 0.9375rem;
  }

  .building-card__prices li:first-child {
    padding-top: 0;
    border-top: none;
  }

  .building-card__type {
    color: var(--color-text-muted);
  }

  .building-card__price {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--color-forest-deep);
    white-space: nowrap;
  }

  @media (max-width: 64rem) {
    .building-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .building-list {
      grid-template-columns: 1fr;
    }
  }

  .cta {
    text-align: center;
  }

  .cta h2 {
    margin-bottom: 0.75rem;
  }

  .cta__lede {
    margin-inline: auto;
    max-width: 30rem;
  }

  .cta__actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 56rem) {
    .plans-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .plans-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
