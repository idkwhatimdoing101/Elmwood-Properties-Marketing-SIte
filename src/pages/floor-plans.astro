---
import Layout from "../layouts/Layout.astro";
import Divider from "../components/Divider.astro";
import Photo from "../components/Photo.astro";

type UnitType = "studio" | "oneBed" | "twoBed" | "threeBed" | "fourBed" | "fiveBed";

interface Building {
  address: string;
  studio: number | null;
  oneBed: number | null;
  twoBed: number | null;
  threeBed: number | null;
  fourBed: number | null;
  fiveBed: number | null;
}

// Pricing as of July 2026 — update here as availability changes.
const buildings: Building[] = [
  { address: "1040 Como Ave SE", studio: 1250, oneBed: 1475, twoBed: null, threeBed: null, fourBed: null, fiveBed: null },
  { address: "1100 Como Ave SE", studio: null, oneBed: 1300, twoBed: null, threeBed: null, fourBed: null, fiveBed: null },
  { address: "1410 Rollins Ave SE", studio: null, oneBed: null, twoBed: 1750, threeBed: 2400, fourBed: null, fiveBed: null },
  { address: "1720 Rollins Ave SE", studio: null, oneBed: null, twoBed: null, threeBed: null, fourBed: 3000, fiveBed: null },
  { address: "817 12th Ave SE", studio: 1150, oneBed: 1300, twoBed: 1650, threeBed: null, fourBed: null, fiveBed: null },
  { address: "823 15th Ave SE", studio: 1250, oneBed: 1575, twoBed: null, threeBed: 2300, fourBed: null, fiveBed: null },
  { address: "829 15th Ave SE", studio: null, oneBed: null, twoBed: null, threeBed: null, fourBed: null, fiveBed: 3200 },
  { address: "837 15th Ave SE", studio: null, oneBed: null, twoBed: null, threeBed: 2400, fourBed: null, fiveBed: null },
  { address: "918 17th Ave SE", studio: null, oneBed: null, twoBed: null, threeBed: null, fourBed: 2800, fiveBed: null },
  { address: "924 17th Ave SE", studio: null, oneBed: null, twoBed: 1750, threeBed: null, fourBed: 3000, fiveBed: null },
];

const unitTypes: { key: UnitType; name: string; beds: number }[] = [
  { key: "studio", name: "Studio", beds: 0 },
  { key: "oneBed", name: "1 Bedroom", beds: 1 },
  { key: "twoBed", name: "2 Bedroom", beds: 2 },
  { key: "threeBed", name: "3 Bedroom", beds: 3 },
  { key: "fourBed", name: "4 Bedroom", beds: 4 },
  { key: "fiveBed", name: "5 Bedroom", beds: 5 },
];

const startingPrice = (key: UnitType) => {
  const prices = buildings.map((b) => b[key]).filter((p): p is number => p !== null);
  return prices.length ? Math.min(...prices) : null;
};

const bedLabel = (beds: number) => (beds === 0 ? "Studio layout" : `${beds} bed`);
const fmt = (price: number | null) => (price === null ? "—" : `$${price.toLocaleString()}`);
---

<Layout
  title="Floor Plans"
  description="Studio through 5 bedroom apartments and houses at Elmwood, all in SE Como and Marcy-Holmes near the U of M. See current pricing by building."
>
  <section class="section hero-sm">
    <div class="wrap">
      <p class="eyebrow">Floor Plans</p>
      <h1>Six sizes, one standard of upkeep.</h1>
      <p class="lede">
        From a studio to a five-bedroom house, every Elmwood residence gets the same quarry
        tile floors, the same 24/7 maintenance, and the same team answering the phone.
      </p>
    </div>
  </section>

  <Divider />

  <section class="section">
    <div class="wrap plans-grid">
      {
        unitTypes.map((type) => {
          const price = startingPrice(type.key);
          return (
            <div class="plan-card">
              <Photo label={`${type.name} layout`} ratio="4 / 3" tone="sage" />
              <div class="plan-card__body">
                <h3>{type.name}</h3>
                <p class="plan-card__meta">{bedLabel(type.beds)}</p>
                <p class="plan-card__price">
                  {price ? `Starting at ${fmt(price)}/mo` : "Contact us for current pricing"}
                </p>
                <a href="/apply" class="btn btn-outline plan-card__cta">
                  Apply for this floor plan
                </a>
              </div>
            </div>
          );
        })
      }
    </div>

    <div class="wrap houses-note">
      <p class="eyebrow">Looking for a house instead?</p>
      <p class="lede">
        Several of our 3, 4, and 5 bedroom floor plans are full houses, not apartment units —
        same SE Como and Marcy-Holmes neighborhoods, same Elmwood upkeep. Let us know what
        you're looking for and we'll tell you what's available.
      </p>
      <a href="/contact" class="text-link">Ask about house availability →</a>
    </div>
  </section>

  <section class="section section--sage">
    <div class="wrap">
      <p class="eyebrow">By Building</p>
      <h2 class="table-heading">Current pricing, address by address.</h2>
      <p class="lede table-lede">
        Pricing shown as of July 2026 and subject to change. Call or apply to confirm what's
        actually available right now.
      </p>

      <div class="table-scroll">
        <table class="pricing-table">
          <thead>
            <tr>
              <th scope="col">Address</th>
              {unitTypes.map((type) => <th scope="col">{type.name}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              buildings.map((b) => (
                <tr>
                  <th scope="row">{b.address}</th>
                  {unitTypes.map((type) => (
                    <td class={b[type.key] === null ? "is-empty" : ""}>{fmt(b[type.key])}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section cta">
    <div class="wrap cta__inner">
      <h2>Included in rent for most apartments</h2>
      <p class="lede cta__lede">Parking, internet, water, and bicycle storage — see the full list on Amenities.</p>
      <div class="cta__actions">
        <a href="/amenities" class="btn btn-primary">View Amenities</a>
        <a href="/apply" class="btn btn-outline">Apply Now</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-sm h1 {
    margin-block: 0.9rem 1rem;
    max-width: 34rem;
  }

  .hero-sm .lede {
    max-width: 36rem;
  }

  .plans-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem;
    margin-bottom: 3.5rem;
  }

  .plan-card {
    border: 1px solid var(--color-sage-line);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-ivory);
  }

  .plan-card__body {
    padding: 1.5rem;
  }

  .plan-card__meta {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-block: 0.4rem 0.9rem;
  }

  .plan-card__price {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-forest);
    margin-bottom: 1.25rem;
  }

  .plan-card__cta {
    width: 100%;
    justify-content: center;
  }

  .houses-note {
    max-width: 38rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-sage-line);
  }

  .houses-note .lede {
    margin-block: 0.9rem 1.25rem;
  }

  .text-link {
    display: inline-block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-forest);
    text-decoration: none;
    border-bottom: 1px solid var(--color-forest);
    padding-bottom: 2px;
  }

  .table-heading {
    margin-block: 0.9rem 0.6rem;
  }

  .table-lede {
    margin-bottom: 2rem;
  }

  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--color-sage-line);
    border-radius: var(--radius-md);
    background: var(--color-ivory);
  }

  .pricing-table {
    width: 100%;
    min-width: 42rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .pricing-table th,
  .pricing-table td {
    padding: 0.9rem 1.1rem;
    text-align: right;
    white-space: nowrap;
    border-bottom: 1px solid var(--color-sage-line);
  }

  .pricing-table thead th {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .pricing-table thead th:first-child,
  .pricing-table tbody th {
    text-align: left;
  }

  .pricing-table tbody th {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
    color: var(--color-charcoal);
  }

  .pricing-table tbody td {
    font-variant-numeric: tabular-nums;
    color: var(--color-forest-deep);
    font-weight: 600;
  }

  .pricing-table tbody td.is-empty {
    color: var(--color-sage-line);
    font-weight: 400;
  }

  .pricing-table tbody tr:last-child th,
  .pricing-table tbody tr:last-child td {
    border-bottom: none;
  }

  .cta {
    text-align: center;
  }

  .cta h2 {
    margin-bottom: 0.75rem;
  }

  .cta__lede {
    margin-inline: auto;
    max-width: 30rem;
  }

  .cta__actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 56rem) {
    .plans-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .plans-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
