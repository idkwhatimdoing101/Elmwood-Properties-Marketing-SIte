---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Divider from "../components/Divider.astro";
import Photo from "../components/Photo.astro";
import { buildings, unitTypes, startingPrice, bedLabel, fmt } from "../data/floorplans";
import { buildingPhotos } from "../data/buildingPhotos";
import { calendlyUrl } from "../data/site";
---

<Layout
  title="Floor Plans & Pricing"
  description="Apartments near the University of Minnesota — studio through 4-bedroom floor plans and pricing at Elmwood, in the SE Como and Marcy-Holmes neighborhoods of Minneapolis, MN. Browse all seven buildings."
>
  <section class="section hero-sm">
    <div class="wrap">
      <p class="eyebrow">Floor Plans</p>
      <h1>Shop by floorplan or building</h1>
      <p class="lede">
        From a studio to a four-bedroom house, every Elmwood residence gets the same quarry
        tile floors, the same 24/7 maintenance, and the same team answering the phone.
      </p>
    </div>
  </section>

  <Divider />

  <section class="section section--sage">
    <div class="wrap">
      <p class="eyebrow">By Building</p>
      <h2 class="table-heading">Seven buildings, one office.</h2>
      <p class="lede table-lede">
        All seven Elmwood buildings sit in the SE Como and Marcy-Holmes neighborhoods of
        Minneapolis, MN, within about a mile of the University of Minnesota campus. Pick a
        building below for photos, availability, and what makes that address different.
      </p>

      <ul class="building-list">
        {
          buildings.map((b) => {
            const exterior = buildingPhotos[b.slug]?.find((p) => p.category === "exterior");
            return (
              <li class="building-card">
                <a href={`/buildings/${b.slug}`} class="building-card__link">
                  {
                    exterior ? (
                      <Image
                        src={exterior.src}
                        alt={`Exterior of ${b.address}, Minneapolis, MN`}
                        widths={[300, 600, 900]}
                        sizes="(max-width: 64rem) 50vw, 33vw"
                        loading="lazy"
                        class="building-card__img"
                      />
                    ) : (
                      <Photo label={`${b.address} exterior`} ratio="4 / 3" tone="forest" />
                    )
                  }
                  <div class="building-card__body">
                    <h3 class="building-card__address">{b.address}, Minneapolis, MN</h3>
                    <span class="text-link">See building details →</span>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap plans-grid">
      {
        unitTypes.map((type) => {
          const price = startingPrice(type.key);
          const photo = buildingPhotos[type.buildingSlug]?.find((p) => p.category === "exterior");
          return (
            <div class="plan-card" id={type.key}>
              {
                photo ? (
                  <Image
                    src={photo.src}
                    alt={`${type.name} apartment building exterior, Minneapolis, MN`}
                    widths={[300, 600, 900]}
                    sizes="(max-width: 56rem) 50vw, 33vw"
                    loading="lazy"
                    class="plan-card__img"
                  />
                ) : (
                  <Photo label={`${type.name} layout`} ratio="4 / 3" tone="sage" />
                )
              }
              <div class="plan-card__body">
                <h3>{type.name}</h3>
                <p class="plan-card__meta">{bedLabel(type.beds)}</p>
                <p class="plan-card__price">
                  {price ? `Starting at ${fmt(price)}/mo` : "Contact us for current pricing"}
                </p>
                <a href={calendlyUrl} target="_blank" rel="noopener" class="btn btn-outline plan-card__cta">
                  Book a Tour
                </a>
              </div>
            </div>
          );
        })
      }
    </div>

    <div class="wrap houses-note">
      <p class="eyebrow">Looking for a house instead?</p>
      <p class="lede">
        Several of our 3 and 4 bedroom floor plans are full houses, not apartment units —
        same SE Como and Marcy-Holmes neighborhoods, same Elmwood upkeep. Let us know what
        you're looking for and we'll tell you what's available.
      </p>
      <a href="/contact" class="text-link">Ask about house availability →</a>
    </div>
  </section>

  <section class="section cta">
    <div class="wrap cta__inner">
      <h2>Included in rent for most apartments</h2>
      <p class="lede cta__lede">Parking, internet, water, and bicycle storage — see the full list on Amenities.</p>
      <div class="cta__actions">
        <a href="/amenities" class="btn btn-primary">View Amenities</a>
        <a href={calendlyUrl} target="_blank" rel="noopener" class="btn btn-outline">Book a Tour</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-sm h1 {
    margin-block: 0.9rem 1rem;
    max-width: 34rem;
  }

  .hero-sm .lede {
    max-width: 36rem;
  }

  .plans-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem;
    margin-bottom: 3.5rem;
  }

  .plan-card {
    border: 1px solid var(--color-sage-line);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-ivory);
    scroll-margin-top: 7rem;
  }

  .plan-card__img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .plan-card__body {
    padding: 1.5rem;
  }

  .plan-card__meta {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-block: 0.4rem 0.9rem;
  }

  .plan-card__price {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-forest);
    margin-bottom: 1.25rem;
  }

  .plan-card__cta {
    width: 100%;
    justify-content: center;
  }

  .houses-note {
    max-width: 38rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-sage-line);
  }

  .houses-note .lede {
    margin-block: 0.9rem 1.25rem;
  }

  .text-link {
    display: inline-block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-forest);
    text-decoration: none;
    border-bottom: 1px solid var(--color-forest);
    padding-bottom: 2px;
  }

  .table-heading {
    margin-block: 0.9rem 0.6rem;
  }

  .table-lede {
    margin-bottom: 2rem;
    max-width: 42em;
  }

  .building-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .building-card {
    background: var(--color-ivory);
    border: 1px solid var(--color-sage-line);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .building-card:hover {
    border-color: var(--color-forest);
  }

  .building-card__link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .building-card__img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .building-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
  }

  .building-card__address {
    font-size: 1rem;
    color: var(--color-charcoal);
  }

  @media (max-width: 64rem) {
    .building-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .building-list {
      grid-template-columns: 1fr;
    }
  }

  .cta {
    text-align: center;
  }

  .cta h2 {
    margin-bottom: 0.75rem;
  }

  .cta__lede {
    margin-inline: auto;
    max-width: 30rem;
  }

  .cta__actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 56rem) {
    .plans-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .plans-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
