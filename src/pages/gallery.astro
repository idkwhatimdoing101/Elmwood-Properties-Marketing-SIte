---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Divider from "../components/Divider.astro";
import { buildingContent } from "../data/buildings";
import { buildingPhotos } from "../data/buildingPhotos";
import { calendlyUrl } from "../data/site";

const categoryLabel = { exterior: "exteriors", interior: "interiors", amenity: "amenities" } as const;

const photos = buildingContent.flatMap((building) =>
  (buildingPhotos[building.slug] ?? [])
    .filter((photo) => photo.category !== "floorplan")
    .map((photo) => ({
      src: photo.src,
      category: categoryLabel[photo.category as "exterior" | "interior" | "amenity"],
      alt: `${photo.label} at ${building.address}, Minneapolis, MN`,
    })),
);

const filters = [
  { key: "all", label: "All" },
  { key: "interiors", label: "Interiors" },
  { key: "amenities", label: "Amenities" },
  { key: "exteriors", label: "Exteriors" },
];
---

<Layout
  title="Gallery"
  description="Real photos of Elmwood's apartments, buildings, and the SE Como and Marcy-Holmes neighborhoods near the University of Minnesota."
>
  <section class="section hero-sm">
    <div class="wrap">
      <p class="eyebrow">Gallery</p>
      <h1>A look inside, before you visit.</h1>
      <p class="lede">
        Real photos of our units, buildings, and floor plans across every Elmwood address in SE
        Como and Marcy-Holmes.
      </p>
    </div>
  </section>

  <Divider />

  <section class="section section--tight">
    <div class="wrap">
      <div class="filters" role="tablist" aria-label="Filter gallery by category">
        {
          filters.map((filter, i) => (
            <button
              type="button"
              class="filter-btn"
              data-filter={filter.key}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              {filter.label}
            </button>
          ))
        }
      </div>

      <div class="gallery-grid" id="gallery-grid">
        {
          photos.map((photo, i) => (
            <div class="gallery-item" data-category={photo.category}>
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[300, 600, 900]}
                sizes="(max-width: 30rem) 100vw, (max-width: 56rem) 50vw, 25vw"
                loading={i < 4 ? "eager" : "lazy"}
                class="gallery-item__img"
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section cta">
    <div class="wrap cta__inner">
      <h2>Prefer to see it in person?</h2>
      <div class="cta__actions">
        <a href={calendlyUrl} target="_blank" rel="noopener" class="btn btn-primary">Schedule a Tour</a>
        <a href="/floor-plans" class="btn btn-outline">View Floor Plans</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const items = document.querySelectorAll<HTMLElement>(".gallery-item");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      buttons.forEach((b) => b.setAttribute("aria-pressed", "false"));
      btn.setAttribute("aria-pressed", "true");

      const filter = btn.dataset.filter;
      items.forEach((item) => {
        const show = filter === "all" || item.dataset.category === filter;
        item.style.display = show ? "" : "none";
      });
    });
  });
</script>

<style>
  .hero-sm h1 {
    margin-block: 0.9rem 1rem;
  }

  .hero-sm .lede {
    max-width: 34rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }

  .filter-btn {
    background: transparent;
    border: 1px solid var(--color-sage-line);
    border-radius: 999px;
    padding: 0.55em 1.2em;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    color: var(--color-text-muted);
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .filter-btn:hover {
    border-color: var(--color-forest);
    color: var(--color-forest);
  }

  .filter-btn[aria-pressed="true"] {
    background: var(--color-forest);
    border-color: var(--color-forest);
    color: var(--color-ivory);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .gallery-item__img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    display: block;
  }

  @media (max-width: 56rem) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 30rem) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }

  .cta {
    text-align: center;
  }

  .cta__actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }
</style>
