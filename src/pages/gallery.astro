---
import Layout from "../layouts/Layout.astro";
import Divider from "../components/Divider.astro";
import Photo from "../components/Photo.astro";

const photos = [
  { label: "Studio living space", category: "interiors", tone: "sage", ratio: "4 / 5", tall: true },
  { label: "Kitchen with dishwasher", category: "interiors", tone: "brass", ratio: "4 / 3" },
  { label: "Quarry tile bathroom", category: "interiors", tone: "sage", ratio: "4 / 3" },
  { label: "Double-sink vanity", category: "interiors", tone: "brass", ratio: "1 / 1" },
  { label: "Bedroom, natural light", category: "interiors", tone: "sage", ratio: "4 / 5", tall: true },
  { label: "Covered bike storage", category: "amenities", tone: "brass", ratio: "4 / 3" },
  { label: "In-building laundry", category: "amenities", tone: "sage", ratio: "1 / 1" },
  { label: "Secured entry", category: "amenities", tone: "brass", ratio: "4 / 3" },
  { label: "Building exterior, SE Como", category: "exteriors", tone: "forest", ratio: "4 / 5", tall: true },
  { label: "Front entrance, evening light", category: "exteriors", tone: "forest", ratio: "4 / 3" },
  { label: "Elmwood house, Marcy-Holmes", category: "exteriors", tone: "sage", ratio: "4 / 3" },
  { label: "Van Cleve Park, nearby", category: "neighborhood", tone: "sage", ratio: "4 / 3" },
  { label: "Dinkytown storefronts", category: "neighborhood", tone: "brass", ratio: "1 / 1" },
  { label: "Walk to campus", category: "neighborhood", tone: "sage", ratio: "4 / 5", tall: true },
];

const filters = [
  { key: "all", label: "All" },
  { key: "interiors", label: "Interiors" },
  { key: "amenities", label: "Amenities" },
  { key: "exteriors", label: "Exteriors" },
  { key: "neighborhood", label: "Neighborhood" },
];
---

<Layout
  title="Gallery"
  description="A look inside Elmwood's apartments, buildings, and the SE Como and Marcy-Holmes neighborhoods that surround them."
>
  <section class="section hero-sm">
    <div class="wrap">
      <p class="eyebrow">Gallery</p>
      <h1>A look inside, before you visit.</h1>
      <p class="lede">
        Real photos of our units, buildings, and the neighborhood are on the way. In the
        meantime, here's how the collection will be organized.
      </p>
    </div>
  </section>

  <Divider />

  <section class="section section--tight">
    <div class="wrap">
      <div class="filters" role="tablist" aria-label="Filter gallery by category">
        {
          filters.map((filter, i) => (
            <button
              type="button"
              class="filter-btn"
              data-filter={filter.key}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              {filter.label}
            </button>
          ))
        }
      </div>

      <div class="gallery-grid" id="gallery-grid">
        {
          photos.map((photo) => (
            <div class={`gallery-item ${photo.tall ? "gallery-item--tall" : ""}`} data-category={photo.category}>
              <Photo label={photo.label} ratio={photo.ratio} tone={photo.tone as "sage" | "forest" | "brass"} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section cta">
    <div class="wrap cta__inner">
      <h2>Prefer to see it in person?</h2>
      <div class="cta__actions">
        <a href="/contact" class="btn btn-primary">Schedule a Tour</a>
        <a href="/floor-plans" class="btn btn-outline">View Floor Plans</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const items = document.querySelectorAll<HTMLElement>(".gallery-item");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      buttons.forEach((b) => b.setAttribute("aria-pressed", "false"));
      btn.setAttribute("aria-pressed", "true");

      const filter = btn.dataset.filter;
      items.forEach((item) => {
        const show = filter === "all" || item.dataset.category === filter;
        item.style.display = show ? "" : "none";
      });
    });
  });
</script>

<style>
  .hero-sm h1 {
    margin-block: 0.9rem 1rem;
  }

  .hero-sm .lede {
    max-width: 34rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }

  .filter-btn {
    background: transparent;
    border: 1px solid var(--color-sage-line);
    border-radius: 999px;
    padding: 0.55em 1.2em;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    color: var(--color-text-muted);
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .filter-btn:hover {
    border-color: var(--color-forest);
    color: var(--color-forest);
  }

  .filter-btn[aria-pressed="true"] {
    background: var(--color-forest);
    border-color: var(--color-forest);
    color: var(--color-ivory);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .gallery-item--tall {
    grid-row: span 2;
  }

  .gallery-item--tall :global(.photo) {
    height: 100%;
  }

  @media (max-width: 56rem) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 30rem) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .gallery-item--tall {
      grid-row: auto;
    }
  }

  .cta {
    text-align: center;
  }

  .cta__actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }
</style>
