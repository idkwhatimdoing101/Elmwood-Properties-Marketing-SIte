---
// Placeholder pages for resident services that aren't built yet.
// Only "coming-soon" services get a page here. Once a service is live it has
// its own file in this folder (see src/data/residentServices.ts).
import Layout from "../../layouts/Layout.astro";
import { residentServices, type ResidentService } from "../../data/residentServices";

export function getStaticPaths() {
  return residentServices
    .filter((s) => s.status === "coming-soon")
    .map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props as { service: ResidentService };
---

<Layout
  title={service.title}
  description={`${service.title}: coming soon to the Elmwood Apartments resident portal.`}
  noindex
>
  <section class="section hero-sm">
    <div class="wrap wrap--narrow">
      <p class="eyebrow"><a href="/residents">Resident Portal</a></p>
      <h1>{service.title}</h1>
      <p class="lede">
        This is coming soon. Until then, please call the office at
        <a href="tel:+16126234488">(612) 623-4488</a> and we'll take care of it.
      </p>
      <a href="/residents" class="btn btn-outline">Back to Resident Portal</a>
    </div>
  </section>
</Layout>

<style>
  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .lede {
    margin-bottom: 2rem;
  }

  .lede a {
    color: var(--color-forest);
    white-space: nowrap;
  }
</style>
