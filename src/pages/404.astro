---
import Layout from "../layouts/Layout.astro";
import { calendlyUrl } from "../data/site";
---

<Layout
  title="Page Not Found"
  description="Sorry, we couldn't find that page. Browse Elmwood apartments near the University of Minnesota."
  noindex
>
  <section class="section">
    <div class="wrap wrap--narrow not-found">
      <p class="eyebrow">Page not found</p>
      <h1>Sorry, we couldn't find that page.</h1>
      <p class="lede">
        The link may be old or mistyped. Here are some good places to start, or call us at
        <a href="tel:+16126234488">(612) 623-4488</a>. We answer day or night.
      </p>

      <div class="not-found__actions">
        <a href="/floor-plans" class="btn btn-primary">See Floor Plans &amp; Pricing</a>
        <a href="/apply" class="btn btn-outline">Apply Now</a>
        <a href={calendlyUrl} target="_blank" rel="noopener" class="btn btn-outline">Book a Tour</a>
      </div>

      <ul class="not-found__links">
        <li><a href="/">Home</a></li>
        <li><a href="/residents">Resident Portal</a></li>
        <li><a href="/contact">Contact the Office</a></li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    padding-block: 2rem 3rem;
  }

  .lede a {
    color: var(--color-forest);
    white-space: nowrap;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .not-found__links {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    font-weight: 600;
  }

  .not-found__links a {
    color: var(--color-forest);
  }
</style>
